<?xml version="1.0" encoding="utf-8"?>
<!--
    屏幕记账无障碍服务配置。
    packageNames 把事件投递收紧到监视名单（与 SupportedPaymentApps.screenWatchPackages
    保持一致）：其他应用的窗口内容不会投递到服务，也省电。
    新增监视应用时两处要同步更新。

    事件类型：
    - typeWindowStateChanged：Activity/窗口切换（京东成功页是独立 Activity，
      靠它触发）；
    - typeWindowContentChanged：内容变化（淘宝闪购 App 为单 Activity 应用，
      订单列表→详情是内部页面切换、不发窗口切换事件，必须订阅内容变化才能
      捕获；服务端按包名做了 1 秒节流，动画/轮播的连续事件不会刷屏遍历）

    accessibilityFlags：
    - flagRetrieveInteractiveWindows：getWindows() 返回全部窗口（金额行在
      独立弹窗窗口里）
    - flagIncludeNotImportantViews：包含 importantForAccessibility=no 的
      节点——京东把金额头部标记为不重要，默认会被系统过滤掉（uiautomator
      自带此标志所以测试时能看到，服务端却看不到）
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200"
    android:packageNames="com.jingdong.app.mall com.taobao.taobao me.ele" />
