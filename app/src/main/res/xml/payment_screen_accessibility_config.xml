<?xml version="1.0" encoding="utf-8"?>
<!--
    屏幕记账无障碍服务配置。
    packageNames 把事件投递收紧到监视名单（与 SupportedPaymentApps.screenWatchPackages
    保持一致）：其他应用的窗口内容不会投递到服务，也省电。
    新增监视应用时两处要同步更新。

    事件类型：
    - typeWindowStateChanged：Activity/窗口切换（唯一订阅源）。
      捕获目标是支付完成后自动弹出的订单页（京东成功页/淘宝闪购订单页/
      拼多多订单详情页均为独立 Activity 或窗口切换可达）；历史订单详情页
      「下单时间」折叠不可见、不命中页面门槛，浏览历史订单零动作。曾试验订阅
      typeWindowContentChanged 以覆盖单 Activity 应用的内部页面切换，
      但按支付完成页的设计无需订阅（内容事件风暴也费电），已移除

    accessibilityFlags：
    - flagRetrieveInteractiveWindows：getWindows() 返回全部窗口（金额行在
      独立弹窗窗口里）
    - flagIncludeNotImportantViews：包含 importantForAccessibility=no 的
      节点——京东把金额头部标记为不重要，默认会被系统过滤掉（uiautomator
      自带此标志所以测试时能看到，服务端却看不到）
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200"
    android:packageNames="com.jingdong.app.mall com.taobao.taobao me.ele com.xunmeng.pinduoduo" />
