<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面长按 App 图标弹出的快捷方式：直接发起添加生日小组件 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutDisabledMessage="@string/shortcut_add_widget_short"
        android:shortcutId="add_birthday_widget"
        android:shortcutLongLabel="@string/shortcut_add_widget_long"
        android:shortcutShortLabel="@string/shortcut_add_widget_short">
        <intent
            android:action="com.aifactory.appmessagecapture.action.ADD_BIRTHDAY_WIDGET"
            android:targetClass="com.aifactory.appmessagecapture.birthday.widget.AddBirthdayWidgetActivity"
            android:targetPackage="com.zhaojin.billcatch" />
    </shortcut>
</shortcuts>
