<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 聊天气泡尾巴（左下）：与气泡共用同一渐变坐标系，浑然一体 -->
    <path android:pathData="M40,68 L34,79 L50,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="32"
                android:endX="78"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF23C4AB" />
                <item android:offset="1.0" android:color="#FF0F9F8A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 白色¥所在的品牌绿气泡：唯一焦点图形 -->
    <path android:pathData="M42,32 h24 a12,12 0 0 1 12,12 v14 a12,12 0 0 1 -12,12 h-24 a12,12 0 0 1 -12,-12 v-14 a12,12 0 0 1 12,-12 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="32"
                android:endX="78"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF23C4AB" />
                <item android:offset="1.0" android:color="#FF0F9F8A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 白色「¥」：从消息中捕获账单 -->
    <path
        android:pathData="M45,41 L54,51.5 L63,41 M54,51.5 L54,64 M47.5,55 L60.5,55 M47.5,60.5 L60.5,60.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
